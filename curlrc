# curl defaults. curl finds this at $XDG_CONFIG_HOME/curlrc on its own (added in 7.73.0) —
# CURL_HOME is only needed to point somewhere else, so nothing is exported for it.
#
# one long-form option per line, no leading dashes, `=` optional for values.
#
# ⚠ SCOPE. this affects every invocation of the curl *binary* by this user, not just
# interactive ones — including the brewed curl that conf.d/brew.fish deliberately puts ahead of
# /usr/bin/curl. it does NOT affect libcurl callers (git, and anything linking the library).
# ⚠ homebrew is unaffected despite HOMEBREW_FORCE_BREWED_CURL=1: Library/Homebrew/utils/curl.rb
# passes `--disable` as the first argument unless HOMEBREW_CURLRC is set, which suppresses this
# file entirely. checked before writing it, because brew shelling out to curl is exactly the
# case a bad global default would break.

# follow redirects. the single most common reason a one-off curl "returns nothing".
location

# ⚠ behaviour change: exit non-zero and print nothing on 4xx/5xx, instead of writing the
# server's error page to stdout and exiting 0. this is what makes `curl ... | sh` and
# `if curl ...` honest. a script that deliberately parses an error body needs --no-fail.
fail

# errors are still reported when output is piped, but the progress meter is not
show-error

# accept and transparently decode gzip/br when the server offers it
compressed

# a request that hangs forever in a script is worse than one that fails
connect-timeout = 10

# transient network failures are common enough to be worth absorbing silently
retry = 3
retry-delay = 2
