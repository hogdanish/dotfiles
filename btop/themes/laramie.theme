#? laramie — tokyo night derived, hand-kept to match every other laramie theme on this machine.
#? ⚠ values come from .claude/skills/laramie/references/spec.md — do not invent one here.

# main background. ⚠ deliberately EMPTY, not "#1f2335": an empty value means "terminal default",
# which is what lets ghostty's background-opacity and background-blur show through btop.
# setting it to the literal background hex would paint an opaque rectangle over the blur.
theme[main_bg]=""

# main text
theme[main_fg]="#a9b1d6"

# title colour for boxes
theme[title]="#c9d3f7"

# highlight colour for keyboard shortcuts
theme[hi_fg]="#3bc5ca"

# selected item in the processes box
theme[selected_bg]="#343a55"
theme[selected_fg]="#c9d3f7"

# inactive/disabled text
theme[inactive_fg]="#656e94"

# text drawn on top of graphs — uptime, network scaling
theme[graph_text]="#a9b1d6"

# background of the percentage meters
theme[meter_bg]="#292e43"

# misc process box text (tree lines, thread counts)
theme[proc_misc]="#3bc5ca"

# box outlines and the divider between them. all four share the terminal-black tone so the
# boxes recede and the data is what carries colour.
theme[cpu_box]="#444b6b"
theme[mem_box]="#444b6b"
theme[net_box]="#444b6b"
theme[proc_box]="#444b6b"
theme[div_line]="#444b6b"

# temperature gradient — calm to alarming
theme[temp_start]="#86c452"
theme[temp_mid]="#e0a332"
theme[temp_end]="#fc8697"

# cpu load gradient
theme[cpu_start]="#86c452"
theme[cpu_mid]="#e0a332"
theme[cpu_end]="#fc8697"

# memory: free — intensity ramp (deep -> base -> loud), brightness rises with the value
theme[free_start]="#59931f"
theme[free_mid]="#86c452"
theme[free_end]="#a7e775"

# memory: cached
theme[cached_start]="#0584da"
theme[cached_mid]="#6cb6fa"
theme[cached_end]="#98ccff"

# memory: available
theme[available_start]="#299194"
theme[available_mid]="#3bc5ca"
theme[available_end]="#49ebf0"

# memory: used — shares the cpu ramp, so "a lot of it" reads the same way everywhere
theme[used_start]="#86c452"
theme[used_mid]="#e0a332"
theme[used_end]="#fc8697"

# network download
theme[download_start]="#299194"
theme[download_mid]="#3bc5ca"
theme[download_end]="#49ebf0"

# network upload — violet, so the two directions are distinguishable at a glance
theme[upload_start]="#9b61c9"
theme[upload_mid]="#cb92fc"
theme[upload_end]="#dab4fe"

# process box cpu gradient
theme[process_start]="#86c452"
theme[process_mid]="#e0a332"
theme[process_end]="#fc8697"
