# laramie — micro truecolour colorscheme. selected by micro/settings.json ("laramie-tc").
#
# ⚠ values come from .claude/skills/laramie/references/spec.md. do not invent one here.
# ⚠ the syntax doctrine (three colours) is enforced by pointing groups at `default`, since
# micro has no "no rule" fallback the way tmTheme does. keywords, types, macros and plain
# identifiers are DELIBERATELY the same colour as body text — do not "fix" them.
# ⚠ micro's group model has no usage-vs-declaration split beyond identifier.class/.function,
# and whether those match declarations depends on each language's syntax file. expect micro to
# land at effectively two syntax colours. that is accepted; do not invent groups to compensate.
# ⚠ NO space after the comma in a "fg,bg" value — a stray one makes the bg fail to parse.

# syntax — literals
color-link constant "#86c452"
color-link constant.number "#86c452"
color-link constant.string "#86c452"
color-link constant.bool "#86c452"
color-link constant.specialChar "#a7e775"

# syntax — a name being introduced
color-link identifier.class "#49ebf0"
color-link identifier.function "#49ebf0"

# syntax — comments. bright on purpose; see the laramie skill's rationale.md §5
color-link comment "#ffc55b"
color-link todo "bold #ffc55b"

# syntax — punctuation recedes
color-link symbol "#9099be"
color-link symbol.brackets "#9099be"
color-link symbol.operator "#9099be"
color-link special "#9099be"

# syntax — plain. everything you do not look for is body text
color-link default "#a9b1d6"
color-link statement "#a9b1d6"
color-link identifier "#a9b1d6"
color-link identifier.macro "#a9b1d6"
color-link type "#a9b1d6"
color-link type.keyword "#a9b1d6"
color-link preproc "#a9b1d6"
color-link underlined "underline #a9b1d6"

# state
color-link error "bold #fc8697"
color-link tab-error "#fc8697"
color-link trailingws "#fc8697"
color-link gutter-error "#1f2335,#fc8697"
color-link gutter-warning "#1f2335,#e0a332"
color-link diff-added "#86c452"
color-link diff-deleted "#fc8697"
color-link diff-modified "#e0a332"

# chrome
color-link statusline "#a9b1d6,#292e43"
color-link tabbar "#a9b1d6,#292e43"
color-link cursor-line "#292e43"
color-link scrollbar "#292e43"
color-link hlsearch "#1f2335,#e0a332"
color-link match-brace "#c9d3f7,#343a55"
color-link divider "#444b6b"
color-link indent-char "#444b6b"
color-link line-number "#656e94"
color-link current-line-number "#c9d3f7"
color-link color-column ""
