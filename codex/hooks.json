{
  "description": "Global Codex adapters for canonical Claude-owned hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/claude-code/hooks/command-policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude-code/hooks/fish-validate.sh\"",
            "timeout": 30,
            "statusMessage": "Validating Fish"
          }
        ]
      }
    ]
  }
}
