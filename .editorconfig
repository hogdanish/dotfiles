# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# fish_indent's output, made non-negotiable at save time.
# see .claude/skills/fish/references/style-guide.md §1
[*.fish]
indent_style = space
indent_size = 4

[*.{Makefile,makefile}]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

# brewfiles are ruby
[Brewfile]
indent_size = 2
