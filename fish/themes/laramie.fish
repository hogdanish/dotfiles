# the laramie palette — the source of truth for every colour fish renders.
# sourced by conf.d/theme.fish. global, not exported: nothing outside fish reads these.

set -g theme_red "#f7768e" # this keyword, html elements, regex group symbol, css units
set -g theme_orange "#ff9e64" # number and boolean constants, language support constants
set -g theme_yellow "#e0af68" # function parameters, regex character sets
set -g theme_light_yellow "#cfc9c2" # parameters inside functions (semantic highlighting only)
set -g theme_green "#9ece6a" # strings, css class names
set -g theme_light_green "#73daca" # object literal keys, markdown links
set -g theme_light_cyan "#b4f9f8" # regex literal strings
set -g theme_cyan "#2ac3de" # language support functions, css html elements
set -g theme_light_blue "#7dcfff" # object properties, regex quantifiers and flags, markdown headings, import/export keywords
set -g theme_blue "#7aa2f7" # function names, css property names
set -g theme_purple "#bb9af7" # control keywords, storage types, regex symbols and operators, html attributes, methods, includes
set -g theme_white "#c0caf5" # variables, classes
set -g theme_foreground "#a9b1d6" # editor fg
set -g theme_light_gray "#9aa5ce" # md, html text
set -g theme_gray "#737aa2" # window fg (on), linenum (on)
set -g theme_dark_gray "#565f89" # window fg (off), comments
set -g theme_darker_gray "#414868" # terminal black
set -g theme_dust "#373d5a" # window fg (hover), highlight, linenum (off), line on window bg containing editor bg
set -g theme_brimstone "#292e42" # editor bg (activeline)
set -g theme_black "#24283b" # editor bg
set -g theme_background "#1f2335" # window bg
set -g theme_vantablack "#1a1b26" # window bg (hover), window line
