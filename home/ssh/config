# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# openssh hardcodes this path — it has no XDG support. this file is a stub; the real config is
# ~/.config/ssh/config. ⚠ first obtained value wins in ssh_config, so Includes must stay at the
# top and the `Host *` defaults live at the bottom of the included file.
Include ~/.ssh/1Password/config
Include ~/.config/ssh/config
