#!/usr/bin/env bash
# cc-notify — raise something from a Claude Code session outside the terminal window.
#
#   cc-notify hold      "Running a benchmark sweep" "~4 min"
#   cc-notify clear     "Benchmark done"
#   cc-notify attention "Godot editor needs a manual restart"
#
# Two channels fire together, deliberately:
#   1. a macOS notification banner — attributed to "Script Editor", so it needs a
#      Focus > Allowed Notifications exception on that app to survive Do Not Disturb;
#   2. an afplay chime — a plain audio file, NOT a notification, so no Focus mode,
#      DND setting or entitlement can suppress it. This is the part that always lands.
set -euo pipefail

readonly SOUND_DIR=/System/Library/Sounds

die() {
    printf 'cc-notify: %s\n' "$1" >&2
    exit 64
}

kind=${1-}
message=${2-}
detail=${3-}

[[ -n $kind && -n $message ]] || die 'usage: cc-notify <hold|clear|attention> <message> [detail]'

case $kind in
hold)
    subtitle='Hands off — leave the machine alone'
    sound=Submarine
    repeat=1
    ;;
clear)
    subtitle='All clear — multitask freely'
    sound=Glass
    repeat=1
    ;;
attention)
    subtitle='Needs you now'
    sound=Sosumi
    repeat=2
    ;;
*) die "unknown kind '$kind' (expected hold|clear|attention)" ;;
esac

if [[ -n $detail ]]; then
    subtitle="$subtitle — $detail"
fi

# applescript string literals: escape backslashes first, then double quotes.
esc() {
    local s=${1//\\/\\\\}
    printf '%s' "${s//\"/\\\"}"
}

# the banner is best-effort; never let a suppressed or failed notification kill the chime.
osascript -e "display notification \"$(esc "$message")\" \
	with title \"Claude Code\" subtitle \"$(esc "$subtitle")\"" >/dev/null 2>&1 || true

if [[ -r "$SOUND_DIR/$sound.aiff" ]]; then
    (
        for ((i = 0; i < repeat; i++)); do
            afplay "$SOUND_DIR/$sound.aiff"
        done
    ) >/dev/null 2>&1 &
fi
