# allowlist mode — nothing is tracked unless it is named below.
#
# ⚠ the leading slash is load-bearing. `/*` is anchored to the repo root, so it matches
#   top-level entries only and git *descends* into whatever is re-included beneath.
#   a bare `*` would match directory entries at every depth, and git "doesn't list excluded
#   directories for performance reasons, so any patterns on contained files have no effect"
#   — every `!foo/**` below it would silently never fire.
#
# consequence worth knowing: git never even stats raycast/ (17 mb) or claude/projects/,
# because they are never re-included. that is the whole point — the default for anything
# a newly installed tool drops into ~/.config is *ignored*.
#
# adding a config? add one `!` line. `git check-ignore -v <path>` says which rule decided.

/*

# ── repo meta ───────────────────────────────────────────────────────────────
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/Brewfile
!/AGENTS.md
!/.betterleaks.toml
!/lefthook.yml
!/.claude/
# transient agent worktrees; git tracks them via .git/worktrees, not here
/.claude/worktrees/
!/.agents/
!/scripts/
!/home/

# ── tracked whole ───────────────────────────────────────────────────────────
!/1Password/
!/act/
!/atuin/
!/bat/
!/btop/
!/ccache/
!/cargo/
!/duti/
!/fastfetch/
!/fd/
!/ghostty/
!/git/
!/glamour/
!/npm/
!/ripgrep/
!/ssh/
!/uv/
!/xh/
!/.bunfig.toml
!/curlrc
!/linode-cli
!/shellcheckrc
!/starship.toml
!/wgetrc

# ── tracked, minus specific contents ────────────────────────────────────────
# re-excludes must come *after* the re-include: last matching pattern wins.
#
# ⚠ never put a trailing comment on a pattern line. `#` only opens a comment at the
#   *start* of a line, so `/fish/fish_variables  # note` is one literal pattern that
#   matches nothing. this bit us once already — the rule looked right and did nothing.

!/fish/
# fish-managed universal state. must stay empty.
/fish/fish_variables

!/micro/
# crash backups, incl. a stale entry from a prior machine, and scratch buffers
/micro/backups/
/micro/buffers/

!/yt-dlp/
# live session cookies. never track, never read.
/yt-dlp/cookies.txt

!/docker/
# DOCKER_CONFIG redirects here (fish/conf.d/xdg-apps.fish). only config.json is authored
# config; contexts/ and buildx/ are regenerated state, and a remote docker context can
# park tls client certs under contexts/ — excluded outright rather than trusting the
# **/*.pem *.key net below, though that net also covers it.
/docker/*
!/docker/config.json

# claude code: the AUTHORED config only, and it lives in its own directory.
# $CLAUDE_CONFIG_DIR points at $XDG_STATE_HOME/claude, which symlinks these three back
# here — so 45 mb of transcripts, prompt history and vendored plugins never sit inside a
# public repo's working tree. `claude/` below is a compatibility symlink to that state dir
# and must stay ignored; nothing in it is config.
!/claude-code/

# codex: Codex-specific settings and profiles. Global instructions and user-authored skills
# are shared from claude-code/. Mutable sessions, logs, auth, plugins, caches, and app databases
# remain under ~/.codex, outside this repo. scripts/link-codex.fish owns the compatibility links.
!/codex/

# ── deliberately never re-included, so `/*` alone keeps them out ────────────
# .wrangler/ cloudflare wrangler resolves its GLOBAL config dir from XDG_CONFIG_HOME, so it
#            lands here, inside the repo. it holds the oauth access + refresh token, which
#            wrangler writes as PLAINTEXT toml by default — conf.d/cloudflare.fish forces
#            CLOUDFLARE_AUTH_USE_KEYRING=true so it is an aes-256-gcm .enc instead, keyed from
#            the macos keychain. never track it either way.
# raycast/   vendored extension build output — .exe binaries, sourcemaps, node_modules
# op/        machine state; `op plugin init` regenerates it, and op/config holds a
#            machine-specific device id that would be *wrong* on another machine
# homebrew/  trust.json is regenerated by brew
# cagent/    docker agent state; first-run marker and machine-specific user uuid

# ── never, at any depth. unanchored, so these win everywhere ────────────────
**/.DS_Store
**/*.pem
**/*.key
**/*.p12
**/id_rsa*
**/id_ed25519*
!**/id_*.pub
**/.env
**/.env.*
!**/.env.tpl
