[alias]
; one-word verbs for things git spells awkwardly. an alias can never shadow a
; builtin subcommand, so these are purely additive — and unlike a fish abbr they
; also work from zsh, from a script, and inside `gh`.
staged = "diff --staged"
unstage = "restore --staged"
amend = "commit --amend --no-edit"
undo = "reset --soft HEAD~1"
last = "show --stat"
root = "rev-parse --show-toplevel"
aliases = "config --get-regexp alias"

; formatted history. `lg` is the graph, `ll` the flat list, `lga` every ref.
; ⚠ the colours are ANSI *names*, not laramie hexes, on purpose: named colours
; resolve through the terminal palette, so this follows the ghostty theme instead
; of adding a fifteenth place the palette has to be hand-duplicated.
lg = "log --graph --pretty=lg --date=human"
lga = "log --graph --all --pretty=lg --date=human"
ll = "log --pretty=lg --date=human --max-count=20"
; ⚠ the inner single quotes are load-bearing: git splits an alias body on
; whitespace with shell rules, so an unquoted --format=… becomes five arguments.
; ⚠ %(color:auto) is a *log* placeholder and is rejected here — for-each-ref
; formats need a real colour name, so the current branch is marked with %(HEAD).
branches = "branch --sort=-committerdate --format='%(color:green)%(HEAD)%(color:blue)%(refname:short)%(color:reset)%(if)%(upstream)%(then) %(color:brightblack)→ %(upstream:short)%(end)  %(color:brightblack)%(committerdate:relative) · %(contents:subject)%(color:reset)'"

[commit]
gpgsign = true

[core]
editor = code-insiders --wait
autocrlf = input
whitespace = trailing-space,space-before-tab
pager = "delta --features=interactive"
excludesFile = ~/.config/git/.gitignore

[credential]
	helper = osxkeychain

[delta]
navigate = true
features = laramie
true-color = always
hyperlinks = true
diff-so-fancy = true
detect-dark-light = always
hyperlinks-file-link-format = "vscode-insiders://file/{path}:{line}"

[diff]
colorMoved = zebra
algorithm = histogram

[fetch]
prune = true

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[gpg]
format = ssh

[gpg "ssh"]
program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
allowedSignersFile = ~/.config/git/allowed_signers

[help]
autocorrect = 10

[include]
; git expands ~/ here but NOT environment variables — $XDG_CONFIG_HOME silently never resolved
path = ~/.config/git/themes.gitconfig

[init]
defaultBranch = main

[interactive]
diffFilter = "delta --features=interactive"

[merge]
conflictStyle = diff3

[pretty]
; the format behind `git lg`/`ll`/`lga`. %C(auto) colours the hash and decorates
; refs by kind; brightblack is palette slot 8, i.e. laramie's dim.
lg = "%C(auto)%h%d%C(reset) %s %C(brightblack)· %ad · %an%C(reset)"

[push]
autoSetupRemote = true
followTags = true

[pull]
rebase = true

[stash]
showPatch = true

[tag]
gpgsign = true

[transfer]
fsckObjects = true

[url "git@github.com:"]
insteadOf = "https://github.com/"
insteadOf = "gh:"

[user]
	email = 121070110+hogdanish@users.noreply.github.com
	name = hogdanish
signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJXQui6phz7OAWsq1PRvJrhJSuMnsYQ6u5kfCIfvU3xU
