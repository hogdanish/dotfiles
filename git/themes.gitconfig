[delta "laramie"]
    # author: https://github.com/hogdanish
    # ⚠ colour values come from .claude/skills/laramie/references/spec.md — do not invent one.
    # ⚠ hex MUST be double-quoted here, or gitconfig reads the leading '#' as a comment.
    dark = true
    syntax-theme = laramie
    side-by-side = false
    file-style = "#c9d3f7" bold
    file-decoration-style = "#444b6b" ul
    file-added-label =
    file-copied-label = 󰆏
    file-modified-label =
    file-removed-label =
    file-renamed-label =
    hunk-header-decoration-style = none
    hunk-header-style = none
    plus-style = "#86c452" "#292e43"
    plus-emph-style = "#1f2335" "#86c452"
    minus-style = "#fc8697" "#292e43"
    minus-emph-style = "#1f2335" "#fc8697"
    line-numbers = true
    # ⚠ these are TEXT. they used to hold a surface-ramp value, at 1.4:1 against the background.
    line-numbers-left-style = "#656e94"
    line-numbers-right-style = "#656e94"
    line-numbers-zero-style = "#656e94"
    line-numbers-minus-style = "#fc8697"
    line-numbers-plus-style = "#86c452"
    line-numbers-left-format = " {nm:>1} "
    line-numbers-right-format = " {np:>1}│ "
    zero-style = syntax
    whitespace-error-style = "#1f2335" "#fc8697"
    blame-code-style = syntax
    blame-palette = "#1f2335" "#292e43" "#343a55" "#444b6b"
    merge-conflict-begin-symbol = ~
    merge-conflict-end-symbol = ~
    merge-conflict-ours-diff-header-style = "#e0a332" bold
    merge-conflict-ours-diff-header-decoration-style = "#444b6b" box
    merge-conflict-theirs-diff-header-style = "#e0a332" bold
    merge-conflict-theirs-diff-header-decoration-style = "#444b6b" box
